#!/bin/sh
# BPM - BDH Package Manager (TLA+ Verified Version)

GITHUB_USER="BackendDeveloperHub"
REPO_URL="https://raw.githubusercontent.com/$GITHUB_USER/bdh-pkg/main"
DB_FILE="/tmp/packages.txt"

B="\033[1;34m"
G="\033[1;32m"
R="\033[1;31m"
W="\033[0m"

if [ -z "$1" ]; then
    echo -e "${B}::${W} BPM (BDH Package Manager) - Arch Style"
    echo "  bpm -S <app>   : Install Package"
    echo "  bpm -Syu       : Update Database"
    echo "  bpm -Ss <app>  : Search Package"
    echo "  bpm -R <app>   : Remove Package"
    exit 1
fi

if [ "$1" = "-Syu" ]; then
    echo -e "${B}::${W} Synchronizing package databases..."
    wget -q -O "$DB_FILE" "$REPO_URL/packages.txt" 2>/dev/null
    if [ -s "$DB_FILE" ]; then
        echo -e "${G}==>${W} Database updated successfully."
    else
        echo -e "${R}==>${W} Error: packages.txt is empty or failed to download."
    fi
    exit 0
fi

if [ "$1" = "-Ss" ]; then
    if [ ! -f "$DB_FILE" ]; then echo -e "${R}==>${W} Database not found! Run 'bpm -Syu' first."; exit 1; fi
    echo -e "${B}::${W} Searching for '$2'..."
    grep -i "$2" "$DB_FILE"
    exit 0
fi

if [ "$1" = "-R" ]; then
    if [ -z "$2" ]; then echo -e "${R}==>${W} Error: No package specified."; exit 1; fi
    rm -f "/bdh_drive/apps/$2" "/bin/$2"
    echo -e "${G}==>${W} Successfully removed $2!"
    exit 0
fi

if [ "$1" = "-S" ]; then
    if [ -z "$2" ]; then echo -e "${R}==>${W} Error: No package specified."; exit 1; fi
    
    case "$2" in
        */*|*..*) echo -e "${R}==>${W} Error: Invalid package name."; exit 1;;
    esac
    
    echo -e "${B}::${W} Resolving dependencies for ${G}$2${W}..."
    mkdir -p /bdh_drive/apps /tmp
    echo -e "${B}::${W} [Downloading] Fetching from BDH Repository..."
    
    TMP_FILE="/tmp/$2.tmp"
    
    # TLA+ Logic: முதலில் /tmp/-க்குள் டவுன்லோட் செய்கிறோம் (Temporary State)
    wget -q -O "$TMP_FILE" "$REPO_URL/bin/$2" 2>/dev/null
    
    # State Verification: ஃபைல் முழுமையாக உள்ளதா என செக் செய்தல்
    if [ -s "$TMP_FILE" ]; then
        # InstallSuccess -> Installed State
        mv "$TMP_FILE" "/bdh_drive/apps/$2"
        chmod +x "/bdh_drive/apps/$2"
        ln -sf "/bdh_drive/apps/$2" "/bin/$2"
        echo -e "${G}==>${W} Successfully installed $2 (Persistent)!"
    else
        # InstallFail -> Reset State
        echo -e "${R}==>${W} Error: Failed to download '$2'. Package may not exist or network failed."
        rm -f "$TMP_FILE" # Rollback: அரைகுறை ஃபைலை அழித்துவிடுகிறோம்
        echo -e "${B}::${W} System state safely restored."
    fi
    exit 0
fi
