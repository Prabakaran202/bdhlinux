#!/bin/sh
# BPM - BDH Package Manager (Secure Version)

GITHUB_USER="BackendDeveloperHub"
# [SECURITY FIX 1] HTTP மாற்றப்பட்டு HTTPS ஆக்கப்பட்டுள்ளது
REPO_URL="https://cdn.jsdelivr.net/gh/$GITHUB_USER/bdh-pkg@main"
DB_FILE="/tmp/packages.txt"

B="\033[1;34m"
G="\033[1;32m"
R="\033[1;31m"
W="\033[0m"

if [ -z "$1" ]; then
    echo -e "${B}::${W} BPM (BDH Package Manager) - Arch Style"
    echo "  bpm -S <app>   : Install Package"
    echo "  bpm -Syu       : Update Database"
    echo "  bpm -Ss <app>  : Search Package"
    echo "  bpm -R <app>   : Remove Package"
    exit 1
fi

if [ "$1" = "-Syu" ]; then
    echo -e "${B}::${W} Synchronizing package databases..."
    wget -q -O "$DB_FILE" "$REPO_URL/packages.txt"
    if [ -s "$DB_FILE" ]; then
        echo -e "${G}==>${W} Database updated successfully."
    else
        echo -e "${R}==>${W} Failed to fetch repository."
    fi
    exit 0
fi

if [ "$1" = "-Ss" ]; then
    if [ ! -f "$DB_FILE" ]; then echo -e "${R}==>${W} Database not found! Run 'bpm -Syu' first."; exit 1; fi
    echo -e "${B}::${W} Searching for '$2'..."
    grep -i "$2" "$DB_FILE"
    exit 0
fi

# புதிய Remove (Uninstall) ஆப்ஷன்
if [ "$1" = "-R" ]; then
    if [ -z "$2" ]; then echo -e "${R}==>${W} Error: No package specified."; exit 1; fi
    rm -f "/bdh_drive/apps/$2" "/bin/$2"
    echo -e "${G}==>${W} Successfully removed $2!"
    exit 0
fi

if [ "$1" = "-S" ]; then
    if [ -z "$2" ]; then echo -e "${R}==>${W} Error: No package specified."; exit 1; fi
    
    # [SECURITY FIX 2] Path Traversal தடுப்பு (பெயரில் / அல்லது .. இருந்தால் தடுக்கப்படும்)
    case "$2" in
        */*|*..*) echo -e "${R}==>${W} Error: Invalid package name."; exit 1;;
    esac
    
    echo -e "${B}::${W} Resolving dependencies for ${G}$2${W}..."
    mkdir -p /bdh_drive/apps
    echo -e "${B}::${W} Downloading from BDH Repository..."
    
    # [SECURITY FIX 3] Wget 100% வெற்றி பெற்றதா என உறுதி செய்தல்
    if wget -q -O "/bdh_drive/apps/$2" "$REPO_URL/bin/$2"; then
        if [ -s "/bdh_drive/apps/$2" ]; then
            chmod +x "/bdh_drive/apps/$2"
            ln -sf "/bdh_drive/apps/$2" "/bin/$2"
            echo -e "${G}==>${W} Successfully installed $2 (Persistent)!"
        else
            echo -e "${R}==>${W} Error: Package '$2' is empty on server."
            rm -f "/bdh_drive/apps/$2"
        fi
    else
        echo -e "${R}==>${W} Error: Failed to download '$2'. Check network or package name."
        rm -f "/bdh_drive/apps/$2"
    fi
    exit 0
fi
